{
  "name": "holmes-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "ENVIRONMENT=local-backend react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "unused": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "concurrently -n test,lint,format,types,unused -c green,yellow,magenta,cyan,blue \"pnpm run test\" \"pnpm run lint\" \"pnpm run format\" \"pnpm run typecheck\" \"pnpm run unused\""
  },
  "dependencies": {
    "@grafana/faro-react": "^2.13.0",
    "@navikt/aksel-icons": "^8.20.1",
    "@navikt/ds-css": "^8.20.1",
    "@navikt/ds-react": "^8.20.1",
    "@navikt/ds-tailwind": "^8.20.1",
    "@navikt/oasis": "^4.2.2",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "isbot": "^5.2.2",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hotkeys-hook": "^5.3.3",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "unleash-client": "^6.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.1.2"
}
