{
  "name": "holmes-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "ENVIRONMENT=local-backend react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "unused": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "concurrently -n test,lint,format,types,unused -c green,yellow,magenta,cyan,blue \"pnpm run test\" \"pnpm run lint\" \"pnpm run format\" \"pnpm run typecheck\" \"pnpm run unused\""
  },
  "dependencies": {
    "@grafana/faro-react": "^2.1.0",
    "@navikt/aksel-icons": "^8.2.0",
    "@navikt/ds-css": "^8.2.0",
    "@navikt/ds-react": "^8.2.0",
    "@navikt/ds-tailwind": "^8.2.0",
    "@navikt/oasis": "^4.1.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@tailwindcss/postcss": "^4.1.13",
    "autoprefixer": "^10.4.21",
    "isbot": "^5",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "^5.2.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.1.13",
    "unleash-client": "^6.7.0",
    "zod": "^4.1.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.51.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "overrides": {
      "@react-router/dev": "^8.3.0",
      "@react-router/node": "^8.3.0",
      "@react-router/serve": "^8.3.0",
      "react-router": "^8.3.0"
    }
  }
}
